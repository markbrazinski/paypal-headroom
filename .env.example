# Copy to .env (git-ignored) and fill in. Never commit real values.
# Only the local server (`npm run dev`, `npm run dev:api`) and the operator scripts read this file.
# The recorded walkthrough (`npm run dev -w web`, then /?demo=1) and every test need none of it.

# --- PayPal sandbox (required by the local server) --------------------------------------------
# A sandbox REST app from developer.paypal.com → Apps & Credentials (Sandbox). Production URLs are refused.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox business account that owns the app (invoices are issued from it).
PAYPAL_MERCHANT_EMAIL=
# Optional: a sandbox webhook id. Webhooks are only hints; Headroom always GETs the resource.
PAYPAL_WEBHOOK_ID=
# Provider call budget. Unset = every PayPal and Plaid call is refused.
# SANDBOX allows invoices, payments and payouts. Budgets expire 2026-12-31 unless overridden below.
HEADROOM_GRANT=SANDBOX
# HEADROOM_GRANT_EXPIRES_AT=2027-03-31T23:59:59Z

# --- Plaid sandbox (optional: read-only bank balances) ----------------------------------------
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

# --- Amazon Bedrock (optional: Nova reads bills and writes the plan's reasons) ----------------
# Unset = bills show "Model not configured here" and the plan uses Headroom's template.
# HEADROOM_MODEL=us.amazon.nova-2-lite-v1:0
# AWS credentials come from the standard chain (AWS_PROFILE, SSO, env). Region us-east-1.
# AWS_PROFILE=
AWS_REGION=us-east-1

# --- Email (optional) ---------------------------------------------------------------------------
# simulated = a labelled in-app mailbox, nothing leaves Headroom. Or set the Gmail test-mode trio below;
# every message then goes only to GMAIL_TEST_INBOX.
MAIL_CHANNEL=simulated
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_TEST_INBOX=

# --- Automated sandbox payer (optional) ---------------------------------------------------------
# A sandbox personal (buyer) account. When set, sample customers pay on PayPal's hosted page through
# the local Google Chrome; the receipt still comes only from PayPal's invoice and capture GETs.
# PAYPAL_PAYER_EMAIL=
# PAYPAL_PAYER_PASSWORD=
# Supplier payouts go to this registered sandbox receiver (a sandbox personal account email).
# PAYPAL_BUYER_EMAIL=

# --- Local server -------------------------------------------------------------------------------
# PORT=8787
# HEADROOM_LOCAL_ROLE=OPERATOR      # JUDGE or OPERATOR shows the sandbox controls drawer

# --- Deploy (scripts/dev/setup.ts copies these into Secrets Manager) ----------------------------
# PAYPAL_REVIEW_CLIENT_ID=          # a second sandbox merchant for the review stage
# PAYPAL_REVIEW_CLIENT_SECRET=
# PAYPAL_REVIEW_MERCHANT_EMAIL=
